{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": [
    ".opencode/rules/01-verification.md",
    ".opencode/rules/decision-log-protocol.md"
  ],
  "experimental": {
    "subagent_depth": 1
  },
  "mcp": {
    "timeout": {
      "startup": 30000,
      "catalog": 30000,
      "execution": 600000
    },
    "servers": {
      // Core-active. No LiteLLM. shadcn is not part of this harness.
      "codebase-memory-mcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "codebase-memory-mcp@0.12.1"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      // Profile: re-analysis (lazy, safe). Never activates offensive C2.
      "ghidra": {
        "type": "remote",
        "url": "http://127.0.0.1:8765/mcp",
        "disabled": true
      },
      "jshook": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@jshookmcp/jshook@0.4.2"
        ],
        "disabled": true
      },
      "idapro": {
        "type": "remote",
        "url": "http://127.0.0.1:13337/mcp",
        "disabled": true
      }
    }
  }
}
