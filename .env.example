# ==============================================================================
# SuperQuantumAGI - Environment Configuration Template
# Target Harness: OpenCode (Vanilla Layer)
# Operator: Fahmi Harun (GitHub: kuker24)
# ==============================================================================
# DO NOT WRITE REAL SECRETS IN THIS FILE OR COMMIT REAL SECRETS TO VERSION CONTROL.
# Copy this file to .env and supply actual keys locally:
#   cp .env.example .env
# ==============================================================================

# --- Model Routing (Native 9router) ---
# Note: 9router is connected natively to OpenCode at ~/.config/opencode/opencode.json.
# No custom model router or LiteLLM gateway is used.
NINEROUTER_API_KEY=your_ninerouter_api_key_placeholder
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1

# --- Core MCP Services (Optional environment parameters) ---
# Context7 Live Docs (free tier / token if configured)
CONTEXT7_API_KEY=your_context7_api_key_placeholder

# Codebase Memory MCP options
CODEBASE_MEMORY_PORT=9749
CODEBASE_MEMORY_PROFILE=analysis

# --- Sandbox & Isolation ---
# Local execution engine: "bwrap" (default Linux) or "docker"
SUPERQ_SANDBOX_ENGINE=bwrap
SUPERQ_SANDBOX_TIMEOUT=60000

# --- Security & Consent (NFR11) ---
# Live consent file. Do not point this at consent/*.example.* — examples are rejected.
PENTEST_CONSENT_FILE=consent/pentest-scope.json

# --- Observability ---
# Local JSONL trace directory
SUPERQ_TRACE_DIR=runtime/traces
